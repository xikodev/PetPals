' ==============================================================================
' @file 3-1-petpals-system-UC.puml
' @brief Core use case diagram for the PetPals peer-to-peer pet care platform.
'
' @details
' Actors and goals of the PetPals mobile application (Pet Owner, Pet Helper)
' and the web administration panel (Administrator). External systems that
' take part in a user goal appear as secondary actors.
'
' Diagram level: System Requirements
' Diagram type:  Use Case Diagram
' ==============================================================================

@startuml

title PetPals - System Use Case Diagram

left to right direction

skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle rectangle

skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #212529
    BackgroundColor<<external system>> #FFF3CD
    BorderColor<<external system>> #856404
}

skinparam usecase {
    BackgroundColor #E7F1FF
    BorderColor #0D6EFD
    ArrowColor #212529
}

' ==============================================================================
' Primary actors
' ==============================================================================

actor "Pet Owner" as Owner
actor "Pet Helper" as Helper
actor "Administrator" as Admin


' Layout-only relationships.
Owner -[hidden]down-> Helper
Helper -[hidden]down-> Admin

' ==============================================================================
' Secondary actors (external systems)
' ==============================================================================

actor "OAuth 2.0 Provider" as IdP <<external system>>
actor "Google Maps API" as Maps <<external system>>
actor "Google Calendar API" as Cal <<external system>>
actor "QR Code API" as QR <<external system>>

' ==============================================================================
' System boundary
' ==============================================================================

rectangle "PetPals System" as PetPals {

    ' Pet Owner
    (Manage pet profiles) as UC_Pets
    (Search helpers on map) as UC_Search
    (Send booking request) as UC_Request
    (Track booking and view route) as UC_Track

    ' Shared by owners and helpers
    (Sign in and set up profile) as UC_SignIn
    (Exchange booking messages) as UC_Msg
    (Confirm service start or completion) as UC_Confirm
    (Confirm by QR code) as UC_QR
    (Rate the other party) as UC_Rate
    (Report a problem with a booking) as UC_Report

    ' Pet Helper
    (Manage service listings) as UC_Listings
    (Block unavailable dates) as UC_Block
    (Review booking request) as UC_Review
    (View history and earnings) as UC_History

    ' Administrator (web panel)
    (Verify users) as UC_Verify
    (Moderate listings) as UC_Moderate
    (Resolve dispute) as UC_Dispute
}

' ==============================================================================
' Actor-to-use-case associations
' ==============================================================================

Owner -- UC_SignIn
Helper -- UC_SignIn
Owner -- UC_Confirm
Helper -- UC_Confirm
Owner -- UC_Msg
Helper -- UC_Msg
Owner -- UC_Rate
Helper -- UC_Rate
Owner -- UC_Report
Helper -- UC_Report

Owner -- UC_Pets
Owner -- UC_Search
Owner -- UC_Request
Owner -- UC_Track

Helper -- UC_Listings
Helper -- UC_Block
Helper -- UC_Review
Helper -- UC_History

Admin -- UC_Verify
Admin -- UC_Moderate
Admin -- UC_Dispute

' ==============================================================================
' UML relationships
' ==============================================================================

' QR confirmation is one of two methods the helper may choose.
UC_Confirm <.. UC_QR : <<extend>>\n[helper chose QR]

' ==============================================================================
' Secondary actor interactions
' ==============================================================================

UC_SignIn -- IdP
UC_Search -- Maps
UC_Track -- Maps
UC_Review -- Cal
UC_QR -- QR


@enduml
