PORT=10000

# Separate settings are used when DATABASE_URL is not set.
DB_HOST=localhost
DB_PORT=5432
DB_USER=dbuser
DB_PASSWORD=replace_me
DB_NAME=appdb

# true for Render's external endpoint; false for local Postgres or Render's
# private internal endpoint without TLS.
DB_SSL=false

# Optional: takes precedence over DB_HOST/PORT/USER/PASSWORD/NAME.
# DATABASE_URL=postgresql://dbuser:replace_me@localhost:5432/appdb
# If DB_SSL is set, do not also put SSL options in DATABASE_URL.
